# Backend environment config. Copy to .env and fill in values. NEVER commit .env.
GCP_PROJECT=ganga-flood
# Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
# Comma-separated origins allowed to call the API (frontend dev + hosting URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
